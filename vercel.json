{
  "headers": [
    {
      "source": "/webby/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/webby/:code([A-Za-z0-9_-]{6,40})",
      "destination": "https://executive.pulsus.tech/demo/webby/:code",
      "permanent": false
    },
    {
      "source": "/webby/:code([A-Za-z0-9_-]{6,40})/",
      "destination": "https://executive.pulsus.tech/demo/webby/:code",
      "permanent": false
    },
    {
      "source": "/systems/tech",
      "destination": "https://abouttech.pulsus.tech/",
      "permanent": true
    },
    {
      "source": "/systems/tech/",
      "destination": "https://abouttech.pulsus.tech/",
      "permanent": true
    },
    {
      "source": "/demo",
      "has": [
        {
          "type": "query",
          "key": "app"
        }
      ],
      "destination": "/walkthrough/",
      "permanent": false
    },
    {
      "source": "/demo/",
      "has": [
        {
          "type": "query",
          "key": "app"
        }
      ],
      "destination": "/walkthrough/",
      "permanent": false
    },
    {
      "source": "/demo",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "(?<view>operational|executive)"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "pz_demo"
        }
      ],
      "destination": "https://executive.pulsus.tech/demo/register?app=platform&next=https%3A%2F%2Fabout.pulsus.tech%2Fdemo%2F%3Fview%3D:view",
      "permanent": false
    },
    {
      "source": "/demo/",
      "has": [
        {
          "type": "query",
          "key": "view",
          "value": "(?<view>operational|executive)"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "pz_demo"
        }
      ],
      "destination": "https://executive.pulsus.tech/demo/register?app=platform&next=https%3A%2F%2Fabout.pulsus.tech%2Fdemo%2F%3Fview%3D:view",
      "permanent": false
    },
    {
      "source": "/demo",
      "missing": [
        {
          "type": "cookie",
          "key": "pz_demo"
        }
      ],
      "destination": "https://executive.pulsus.tech/demo/register?app=platform&next=https%3A%2F%2Fabout.pulsus.tech%2Fdemo%2F",
      "permanent": false
    },
    {
      "source": "/demo/",
      "missing": [
        {
          "type": "cookie",
          "key": "pz_demo"
        }
      ],
      "destination": "https://executive.pulsus.tech/demo/register?app=platform&next=https%3A%2F%2Fabout.pulsus.tech%2Fdemo%2F",
      "permanent": false
    },
    {
      "source": "/demo/report",
      "missing": [
        {
          "type": "cookie",
          "key": "pz_demo"
        }
      ],
      "destination": "https://executive.pulsus.tech/demo/register?app=platform&next=https%3A%2F%2Fabout.pulsus.tech%2Fdemo%2Freport",
      "permanent": false
    },
    {
      "source": "/demo/corporate",
      "missing": [
        {
          "type": "cookie",
          "key": "pz_demo"
        }
      ],
      "destination": "https://executive.pulsus.tech/demo/register?app=platform&next=https%3A%2F%2Fabout.pulsus.tech%2Fdemo%2Fcorporate",
      "permanent": false
    },
    {
      "source": "/demo/corporate/",
      "missing": [
        {
          "type": "cookie",
          "key": "pz_demo"
        }
      ],
      "destination": "https://executive.pulsus.tech/demo/register?app=platform&next=https%3A%2F%2Fabout.pulsus.tech%2Fdemo%2Fcorporate%2F",
      "permanent": false
    },
    {
      "source": "/demo/corporate/report",
      "missing": [
        {
          "type": "cookie",
          "key": "pz_demo"
        }
      ],
      "destination": "https://executive.pulsus.tech/demo/register?app=platform&next=https%3A%2F%2Fabout.pulsus.tech%2Fdemo%2Fcorporate%2Freport",
      "permanent": false
    },
    {
      "source": "/demo/hospital",
      "missing": [
        {
          "type": "cookie",
          "key": "pz_demo"
        }
      ],
      "destination": "https://executive.pulsus.tech/demo/register?app=platform&next=https%3A%2F%2Fabout.pulsus.tech%2Fdemo%2Fhospital",
      "permanent": false
    },
    {
      "source": "/demo/hospital/",
      "missing": [
        {
          "type": "cookie",
          "key": "pz_demo"
        }
      ],
      "destination": "https://executive.pulsus.tech/demo/register?app=platform&next=https%3A%2F%2Fabout.pulsus.tech%2Fdemo%2Fhospital%2F",
      "permanent": false
    },
    {
      "source": "/demo/hospital/report",
      "missing": [
        {
          "type": "cookie",
          "key": "pz_demo"
        }
      ],
      "destination": "https://executive.pulsus.tech/demo/register?app=platform&next=https%3A%2F%2Fabout.pulsus.tech%2Fdemo%2Fhospital%2Freport",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/demo",
      "destination": "https://demo-executive.pulsus.tech/pulse/showcase"
    },
    {
      "source": "/demo/",
      "destination": "https://demo-executive.pulsus.tech/pulse/showcase"
    },
    {
      "source": "/demo/report",
      "destination": "https://demo-executive.pulsus.tech/pulse/showcase/report"
    },
    {
      "source": "/demo/corporate",
      "destination": "https://demo-executive.pulsus.tech/pulse/showcase/corporate"
    },
    {
      "source": "/demo/corporate/",
      "destination": "https://demo-executive.pulsus.tech/pulse/showcase/corporate"
    },
    {
      "source": "/demo/corporate/report",
      "destination": "https://demo-executive.pulsus.tech/pulse/showcase/corporate/report"
    },
    {
      "source": "/demo/hospital",
      "destination": "https://demo-executive.pulsus.tech/pulse/showcase/hospital"
    },
    {
      "source": "/demo/hospital/",
      "destination": "https://demo-executive.pulsus.tech/pulse/showcase/hospital"
    },
    {
      "source": "/demo/hospital/report",
      "destination": "https://demo-executive.pulsus.tech/pulse/showcase/hospital/report"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://demo-executive.pulsus.tech/_next/:path*"
    },
    {
      "source": "/config.js",
      "destination": "https://demo-executive.pulsus.tech/config.js"
    },
    {
      "source": "/:file(pulsus-[a-z-]+\\.png)",
      "destination": "https://demo-executive.pulsus.tech/:file"
    }
  ]
}
